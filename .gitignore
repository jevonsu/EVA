# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
*.egg-info/
dist/
build/
*.spec
*.spec.bak
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local secrets (copy .env.example → .env). Never publish .env.
.env
.env.local
*.pem

# Runtime data — upgrades and git publish must never touch this
data/*
!data/.gitkeep

# User workspace
workspace/*
!workspace/.gitkeep

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Logs & local junk
*.log
logs/
Users/
.agents/
node_modules/

# Editor backups
*.bak
*.tmp
*~
*.orig

# Local DBs (anywhere)
*.db

# Tests live with the publisher (OPC/发布EVA), not in the Eva tree
tests/

