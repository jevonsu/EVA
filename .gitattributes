# Normalize text; shell scripts always LF (required on Linux)
* text=auto

*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.txt text eol=lf
*.env text eol=lf
*.example text eol=lf

# Windows-only helpers keep CRLF if present
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.mp4 binary
*.webm binary
*.pdf binary
*.zip binary
*.whl binary
