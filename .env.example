# Eva — blank delivery template (no secrets). Copy to .env then fill in.
# LLM keys: add after login in 设定 → LLM (do not put API keys here).

# —— Server ——
# F03: default loopback. Use 0.0.0.0 only when you intentionally expose LAN.
HOST=127.0.0.1
PORT=8080
DEBUG=false
# Comma-separated origins. Do NOT use * with credentialed cookies.
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

AGENT_NAME=Eva
DATA_DIR=./data
MCP_SERVERS=

# —— Local username / password auth ——
AUTH_ENABLED=true
AUTH_SESSION_DAYS=7
AUTH_COOKIE_SECURE=false
# Only honor X-Forwarded-For behind a trusted reverse proxy
AUTH_TRUST_PROXY=false
# Optional seed admin when data/auth/users.json is empty (password never stored in plaintext after seed)
# EVA_ADMIN_USER=admin
# EVA_ADMIN_PASSWORD=change-me-now
# Optional pepper override (else data/auth/pepper.txt is auto-generated)
# AUTH_PEPPER=

# Deprecated CardServer remote validate (default off). Leave false.
AUTH_CARD_REMOTE=false
# AUTH_CONTROL_URL=
# AUTH_CONTROL_URLS=
# AUTH_CONTROL_KEY=
AUTH_NODE_ID=eva

# Optional private-repo online update. Leave empty to use local git credentials.
# GITHUB_TOKEN=
# EVA_UPDATE_REPO=jevonsu/EVA

# Human gate: UI 新建进暂存；正式化走设定→评审
HUMAN_EDIT_CERTIFIED_ONLY=true

# —— Release safety (F01/F02) ——
# LLM create_tool / promote / delete hot-load. Leave false for delivery.
ALLOW_CREATE_TOOL=false
# Allow webhook endpoints to set use_tools=true. Leave false for delivery.
WEBHOOK_ALLOW_TOOLS=false

