# Eva — 空白交付模板（无密钥）。复制为 .env 后再填写。
# 启动时直接读取。LLM 不要写在这里：预置 DeepSeek，登录后在「设定 → LLM」填写 API Key。

# —— 服务 ——
HOST=0.0.0.0
PORT=8080
DEBUG=false
CORS_ORIGINS=*

AGENT_NAME=Eva
DATA_DIR=./data
MCP_SERVERS=

AUTH_ENABLED=true
# 发卡网关（客户能访问到的地址）。可写内网 + 公网，登录页出现网络切换。
AUTH_CONTROL_URL=
AUTH_CONTROL_URLS=
# 必须与 CardServer 的 AUTH_CONTROL_KEY 相同。不要把填好的 .env 提交到 Git。
AUTH_CONTROL_KEY=
AUTH_NODE_ID=eva
AUTH_SESSION_DAYS=7
AUTH_COOKIE_SECURE=false

# 私有仓库在线更新（可选）。不填则尝试本机 git 凭据。
# GITHUB_TOKEN=
# EVA_UPDATE_REPO=jevonsu/EVA
