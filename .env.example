# Eva — clean template (no secrets, no device integrations)

LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

HOST=0.0.0.0
PORT=8080
DEBUG=false
CORS_ORIGINS=*

AGENT_NAME=Eva
AGENT_SYSTEM_PROMPT=
MAX_TOOL_ROUNDS=8
MAX_HISTORY_MESSAGES=40

DATA_DIR=./data
MCP_SERVERS=

# === Card Auth / high-security login ===
AUTH_ENABLED=true
# python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_PEPPER=
AUTH_SESSION_DAYS=7
# set true only behind HTTPS
AUTH_COOKIE_SECURE=false
AUTH_ADMIN_USER=admin
AUTH_ADMIN_PASSWORD=change-me-now
# preferred in production (bcrypt hash of password):
# AUTH_ADMIN_PASSWORD_HASH=
